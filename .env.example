# Sitemyra — production-ready environment template.
# Copy to `.env` and fill every `replace-me` / empty value. `.env` is
# git-ignored; this file intentionally contains NO real secrets.

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://apeiro:replace-me@postgres:5432/apeiro
POSTGRES_DB=apeiro
POSTGRES_USER=apeiro
POSTGRES_PASSWORD=replace-me

# --- Redis (Celery broker + result backend) ---
# Production: set REDIS_PASSWORD and include it in REDIS_URL as
#   redis://:replace-me@redis:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=replace-me

# --- Django ---
DJANGO_SECRET_KEY=replace-me-generate-a-64-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# --- Production compose (docker-compose.prod.yml) ---
# Public API origin baked into the Next.js standalone build:
BACKEND_PUBLIC_URL=https://api.example.com
# Host ports (leave default unless colliding):
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Email (SMTP in production; console backend in dev) ---
# Production sender mailbox goes here, e.g. EMAIL_FROM=info@<your-domain>.
# SMTP credentials are configured separately at deploy time and never committed.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
EMAIL_FROM=alerts@example.com
EMAIL_FROM_NAME=Sitemyra
# Legacy provider-key slot (unused unless an email provider is wired up)
EMAIL_PROVIDER_API_KEY=

# --- Stripe billing (empty = billing disabled; API returns 503) ---
# Development stub only with DEBUG=1 AND STRIPE_DEV_STUB=1 (never in prod).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_DEV_STUB=0
STRIPE_DEV_SKIP_WEBHOOK_VERIFY=0

# --- Artifact storage (screenshots / diffs) ---
# local (default, dev) or s3 (production: AWS S3 or S3-compatible/MinIO).
# Existing local artifacts keep working read-only; new writes use the
# configured backend. Retention deletes objects from the backend in use.
ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_ROOT=/app/storage/monitor-artifacts
# S3 settings (only used when ARTIFACT_STORAGE=s3). Credentials stay
# server-side; downloads use short-lived signed URLs after auth.
AWS_STORAGE_BUCKET_NAME=
AWS_STORAGE_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, e.g. "prod".
AWS_STORAGE_PREFIX=
# Signed download URL lifetime in seconds (60-86400).
ARTIFACT_URL_EXPIRES_SECONDS=900

# --- SSO / OAuth (Phase 3: real authorization-code flow) ---
# Flow: login button -> GET /api/auth/oauth/<provider>/start/ -> provider ->
#   <redirect>/auth/callback -> GET /api/auth/oauth/<provider>/callback/.
# Redirect URIs: explicit per-provider value, else <FRONTEND_URL>/auth/callback.
# Register the exact URI in the Google/GitHub provider console.
# Secrets stay server-side; the browser never sees them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://app.example.com/auth/callback
# Signed OAuth state (CSRF) lifetime in seconds.
OAUTH_STATE_TTL_SECONDS=600
