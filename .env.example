# Sitemyra — production-ready environment template.
# Copy to `.env` and fill every `replace-me` / empty value. `.env` is
# git-ignored; this file intentionally contains NO real secrets.

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://apeiro:replace-me@postgres:5432/apeiro
POSTGRES_DB=apeiro
POSTGRES_USER=apeiro
POSTGRES_PASSWORD=replace-me

# --- Redis (Celery broker + result backend) ---
# Production: set REDIS_PASSWORD and include it in REDIS_URL as
#   redis://:replace-me@redis:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=replace-me

# --- Celery workers / queues (docs/BROWSER-WORKER.md) ---
# Queues: celery_http (HTTP checks + scheduler + cleanup),
#         celery_browser (Playwright checks ONLY, dedicated worker),
#         celery_notifications (email/webhook/digest delivery).
# HTTP worker (celery-http-worker) — also consumes celery_notifications:
HTTP_WORKER_CONCURRENCY=4
# Browser worker (celery-browser-worker): keep at 1 — one Chromium per
# child process is the whole isolation model. Never exceed 2.
BROWSER_WORKER_CONCURRENCY=1
# Recycle each prefork child after N tasks (0 disables). Process-level
# companion to BROWSER_MAX_TASKS (browser-level recycle inside a child);
# both default to 50.
BROWSER_MAX_TASKS_PER_CHILD=50
# Browser worker ONLY: it imports the Playwright task module at boot via
# CELERY_IMPORTS=monitors.advanced_tasks. That variable is set per-service
# in the compose files (celery-browser-worker only) — never in .env, which
# is shared with the API/beat containers that run WITHOUT Playwright.
# Prefetch 1 with acks_late = one in-flight task per worker child:
CELERY_TASK_PREFETCH_MULTIPLIER=1
# Reliability (defaults are already correct; listed for visibility):
CELERY_TASK_ACKS_LATE=1
CELERY_TASK_REJECT_ON_WORKER_LOST=1
CELERY_TASK_IGNORE_RESULT=1
# Time limits in seconds: soft aborts inside the task, hard kills the
# worker child (final kill switch). soft must stay <= hard.
CELERY_HTTP_TASK_SOFT_TIME_LIMIT=150
CELERY_HTTP_TASK_TIME_LIMIT=180
CELERY_BROWSER_TASK_SOFT_TIME_LIMIT=180
CELERY_BROWSER_TASK_TIME_LIMIT=240
CELERY_NOTIFICATION_TASK_SOFT_TIME_LIMIT=90
CELERY_NOTIFICATION_TASK_TIME_LIMIT=120
CELERY_SCHEDULER_TASK_SOFT_TIME_LIMIT=50
CELERY_SCHEDULER_TASK_TIME_LIMIT=60
CELERY_DIGEST_TASK_SOFT_TIME_LIMIT=600
CELERY_DIGEST_TASK_TIME_LIMIT=900
CELERY_CLEANUP_TASK_SOFT_TIME_LIMIT=600
CELERY_CLEANUP_TASK_TIME_LIMIT=900

# Scheduler (single-hop fan-out, plan D9): how many due monitors one
# 60 s tick may claim; keeps a large backlog from outrunning workers.
SCHEDULER_BATCH_SIZE=500

# Worker liveness registry for GET /api/health/ (replaces the per-probe
# Celery broadcast — docs/RESOURCE-BUDGET.md section 6). Each worker
# re-registers a TTL'd Redis key every TTL/3 seconds; a worker that dies
# uncleanly drops out of the health response after at most this many
# seconds (3-3600, default 15).
WORKER_HEARTBEAT_TTL_S=15

# Rate limit for the UNAUTHENTICATED marketing demo
# (POST /api/intelligence/public/analyze/). This is a scoped DRF throttle
# on that one view only — no other endpoint is throttled — and it exists
# because the homepage lets a visitor have any public page analysed
# without an account. Lower it if the API origin is exposed to bots.
PUBLIC_ANALYZE_RATE=12/hour

# --- Optional AI narration (Phase 3). ALL EMPTY = disabled = default. ---
#
# Sitemyra is fully functional without these. Every change already has a
# deterministic explanation built from stored evidence, and that text is
# ALWAYS kept even when narration is on. Narration is opt-in per user,
# and a narration whose citations do not resolve is discarded.
#
# AI_API_KEY is read server-side only and must never be exposed to the
# frontend (no NEXT_PUBLIC_ prefix, ever).
#
# AI_PROVIDER: openai | anthropic | custom   (empty = disabled)
# AI_MODEL:   e.g. gpt-4o-mini, claude-3-5-haiku-latest
# AI_BASE_URL: override for "custom", or a proxy for the named providers
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=20

# --- Browser engine (browser worker only; docs/BROWSER-WORKER.md) ---
# One Chromium per prefork child (BROWSER_WORKER_CONCURRENCY=1 above).
# Recycle the browser after N checks (0 = task-count recycle disabled;
# the Celery hard limit above still bounds a runaway browser):
BROWSER_MAX_TASKS=50
# Recycle when the worker process tree RSS exceeds this many MB
# (0 = disabled; unreadable /proc = skipped with a warning, fail-safe):
BROWSER_MAX_RSS_MB=1024
# Playwright launch timeout (ms) — how long to wait for Chromium startup:
BROWSER_LAUNCH_TIMEOUT_MS=30000
# Default page-operation timeout (ms) for anything other than navigation
# (screenshot, content(), evaluate) — explicit so nothing blocks forever:
BROWSER_PAGE_OP_TIMEOUT_MS=30000
# After "load", wait at most this long for the page to go network-idle
# before proceeding (0 = don't wait; chatty pages no longer fail checks):
BROWSER_IDLE_SETTLE_MS=3000
# Resource blocking for dom/price modes (screenshot mode NEVER blocks):
# comma list of images,media,fonts — or "none" to disable entirely.
# HTML/CSS/JS/XHR always load in every mode.
BROWSER_BLOCK_RESOURCES=images,media,fonts
# Fail the check explicitly (never silently crop) when a full-page
# screenshot would exceed this height in px (0 = no cap):
SCREENSHOT_MAX_HEIGHT_PX=0
# Per-check SSRF budget for the request interceptor: max DNS lookups
# before requests fail closed, and how long a validated hostname is
# trusted within one check (seconds). Residual DNS-rebinding TOCTOU is
# documented in docs/BROWSER-WORKER.md:
BROWSER_MAX_DNS_LOOKUPS=200
BROWSER_DNS_CACHE_TTL_S=60

# --- Django ---
DJANGO_SECRET_KEY=replace-me-generate-a-64-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# --- Public website ---
# Public origin used for canonical URLs, sitemap, OpenGraph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sitemyra.com
# Verified public contact mailbox for Sitemyra.
NEXT_PUBLIC_CONTACT_EMAIL=info@sitemyra.com

# --- Production compose (docker-compose.prod.yml) ---
# Public API origin baked into the Next.js standalone build:
BACKEND_PUBLIC_URL=https://api.example.com
# Host ports (leave default unless colliding):
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Backend runtime (entrypoint.sh / settings/production.py) ---
# Port gunicorn listens on INSIDE the container (compose maps
# BACKEND_PORT -> $PORT); default 8000 if unset:
PORT=8000
# Gunicorn worker processes (1 per vCPU is a sane default; the
# scheduler/cleanup/cleanup tasks run in Celery, not here):
GUNICORN_WORKERS=2
# Reuse DB connections for this many seconds (0 = old per-request
# reconnect behaviour) — plan D9:
CONN_MAX_AGE=60
# Set to 1 ONLY behind a TLS-terminating reverse proxy so Django trusts
# X-Forwarded-Proto for redirects/cookies; leave 0 otherwise:
SECURE_PROXY_SSL_HEADER=0

# --- Email (Hostinger SMTP; console backend in dev) ---
# Django send_mail() talks to Hostinger's SMTP directly — no provider API key.
# Port 465 = implicit TLS (EMAIL_USE_SSL=1); port 587 = STARTTLS.
# EMAIL_HOST_PASSWORD is a mailbox password and lives ONLY in .env / your
# deploy secret manager — never in docker-compose files or git.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=alerts@sitemyra.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_FROM=alerts@sitemyra.com
EMAIL_FROM_NAME=Sitemyra
# Optional Reply-To for transactional alert/digest emails. Leave blank until
# a monitored, appropriate reply mailbox is verified.
EMAIL_REPLY_TO=

# --- Stripe billing (empty = billing disabled; API returns 503) ---
# Development stub only with DEBUG=1 AND STRIPE_DEV_STUB=1 (never in prod).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_DEV_STUB=0
STRIPE_DEV_SKIP_WEBHOOK_VERIFY=0

# --- Artifact storage (screenshots / diffs) ---
# local (default, dev) or s3 (production: AWS S3 or S3-compatible/MinIO).
# Existing local artifacts keep working read-only; new writes use the
# configured backend. Retention deletes objects from the backend in use.
ARTIFACT_STORAGE=local
ARTIFACT_LOCAL_ROOT=/app/storage/monitor-artifacts
# Optional retention CAP in days: each monitor keeps
# min(plan history_days, this value) — Free 7 / Pro 30 / Business 90
# unless this caps it LOWER. Unset / 0 = plan limits only (plan D8).
ARTIFACT_RETENTION_DAYS=0
# S3 settings (only used when ARTIFACT_STORAGE=s3). Credentials stay
# server-side; downloads use short-lived signed URLs after auth.
AWS_STORAGE_BUCKET_NAME=
AWS_STORAGE_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, e.g. "prod".
AWS_STORAGE_PREFIX=
# Signed download URL lifetime in seconds (60-86400).
ARTIFACT_URL_EXPIRES_SECONDS=900

# --- SSO / OAuth (Phase 3: real authorization-code flow) ---
# Flow: login button -> GET /api/auth/oauth/<provider>/start/ -> provider ->
#   <redirect>/auth/callback -> GET /api/auth/oauth/<provider>/callback/.
# Redirect URIs: explicit per-provider value, else <FRONTEND_URL>/auth/callback.
# Register the exact URI in the Google/GitHub provider console.
# Secrets stay server-side; the browser never sees them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://app.example.com/auth/callback
# Signed OAuth state (CSRF) lifetime in seconds.
OAUTH_STATE_TTL_SECONDS=600
